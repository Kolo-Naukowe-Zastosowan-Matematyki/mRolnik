# mRolnik – konfiguracja. Skopiuj do pliku .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# === Integrator / serwer ===
MROLNIK_HOST=127.0.0.1
MROLNIK_PORT=8000
MROLNIK_ENV=dev
# MROLNIK_CACHE_DIR=output/cache

# === A. Bezpieczeństwo ===
# Tryb logowania: dev (bez logowania, TYLKO gdy MROLNIK_HOST=127.0.0.1) | password | oidc  (saml: w przygotowaniu)
MROLNIK_AUTH_MODE=dev
# Klucz podpisu sesji (wymagany w prod, min. 32 znaki): python -c "import secrets; print(secrets.token_urlsafe(48))"
MROLNIK_SECRET_KEY=
# Dozwolone źródła CORS, np. https://erolnik.gov.pl (puste = tylko ta sama domena; "*" jest ignorowane)
MROLNIK_ALLOWED_ORIGINS=
# Czas życia sesji w minutach
MROLNIK_SESSION_TTL_MIN=480
# Flaga Secure ciasteczek (domyślnie 1 w prod; ustaw 1, gdy serwer stoi za HTTPS)
# MROLNIK_COOKIE_SECURE=1
# Rola użytkownika w trybie dev: rolnik | doradca | admin
MROLNIK_DEV_ROLE=admin
# Konta w trybie password: login:rola:hash[,login2:rola:hash]; hash: python -m src.security.passwords
MROLNIK_USERS=
# OpenID Connect (SSO eRolnika, Keycloak itp.)
MROLNIK_OIDC_ISSUER=
# MROLNIK_OIDC_DISCOVERY_URL=   (domyślnie <issuer>/.well-known/openid-configuration)
MROLNIK_OIDC_CLIENT_ID=
MROLNIK_OIDC_CLIENT_SECRET=
MROLNIK_OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
MROLNIK_OIDC_SCOPES=openid profile
MROLNIK_OIDC_ROLE_CLAIM=roles
MROLNIK_OIDC_DEFAULT_ROLE=rolnik
# Limity: 0 wyłącza limit żądań (tylko do testów); maks. rozmiar body w KB
MROLNIK_RATE_LIMIT=1
MROLNIK_MAX_BODY_KB=256
# Dodatkowe hosty obrazów/kafli map w CSP img-src (np. kolejne usługi WMS), oddzielone przecinkami.
# Zawsze dozwolone: mapy.geoportal.gov.pl, integracja.gugik.gov.pl, *.tile.openstreetmap.org
# MROLNIK_CSP_IMG_HOSTS=https://wms.example.gov.pl
# Adresy reverse proxy, którym ufamy w nagłówkach X-Forwarded-For/-Proto (uvicorn)
MROLNIK_FORWARDED_ALLOW_IPS=127.0.0.1
# Rozgrzewanie bufora analiz przy starcie (0/1)
MROLNIK_WARMUP=0


# === B. Źródła danych ===
# Copernicus Data Space Ecosystem (NDVI Sentinel-2). Bez tych kluczy NDVI = "brak danych".
# Rejestracja: https://dataspace.copernicus.eu → https://shapps.dataspace.copernicus.eu/dashboard → User settings → OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Adres kontaktowy dodawany do User-Agent zapytań do usług publicznych (zalecane przez operatorów API)
MROLNIK_CONTACT_EMAIL=
# 1 = bez połączeń z usługami zewnętrznymi (wszystkie dane "brak"; nic nie jest symulowane)
MROLNIK_OFFLINE_DEMO=0
# Hydrografia (cieki/rowy) z usług WFS – lista adresów po przecinku; puste = domyślne (KZGW MPHP, GUGiK BDOT10k)
# MROLNIK_HYDRO_WFS_URLS=
# Nazwy warstw WFS (puste = wykrywanie z GetCapabilities po słowach SWRS/SWKN/ciek/rów)
# MROLNIK_HYDRO_WFS_TYPENAMES=
# Warstwa WMS z siecią wodną do podglądu na mapie (puste = kompozycja BDOT10k GUGiK, warstwy z GetCapabilities)
# MROLNIK_HYDRO_WMS_URL=
# MROLNIK_HYDRO_WMS_LAYERS=

# === C. Kalkulatory / GUI ===
